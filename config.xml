<?xml version='1.0' encoding='utf-8'?>
<widget id="com.neurasamu.build.pdf_gem" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>PDF Gem</name>
    <description>AI Text-to-PDF Engine</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <!-- Splash Screen Fix -->
    <preference name="SplashScreen" value="none" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="AutoHideSplashScreen" value="true" />
    
    <platform name="android">
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="33" />
        <preference name="android-compileSdkVersion" value="33" />
        
        <!-- Cleartext HTTP Fix for 127.0.0.1 -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
        
        <icon src="res/icon/android/icon-48.png" density="mdpi" />
        <icon src="res/icon/android/icon-72.png" density="hdpi" />
        <icon src="res/icon/android/icon-96.png" density="xhdpi" />
        <icon src="res/icon/android/icon-144.png" density="xxhdpi" />
        <icon src="res/icon/android/icon-192.png" density="xxxhdpi" />
    </platform>
</widget>
